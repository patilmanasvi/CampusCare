# Copy this file to ".env.local" and adjust the values.
# Never put passwords, API keys or Jira credentials in frontend env files:
# everything prefixed with VITE_ ends up in the browser bundle.

# Base URL of the Express backend (Member 2). Ask Member 2 for the final value.
VITE_API_BASE_URL=http://localhost:5000/api

# true  = use the built-in mock API (no backend needed)
# false = call the real backend at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Fake network delay for the mock API, in milliseconds.
VITE_MOCK_LATENCY_MS=400

# How often the notification bell checks for new notifications (ms).
VITE_NOTIFICATION_POLL_MS=60000

# Optional: only accept emails from this domain on the login screen,
# e.g. college.edu. Leave empty to accept any valid email address.
VITE_COLLEGE_EMAIL_DOMAIN=
