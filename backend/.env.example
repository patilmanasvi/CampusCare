# ==============================================================================
# CampusCare Backend Environment Configuration
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campuscare_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_campuscare_key_change_in_production
JWT_EXPIRES_IN=24h

# File Uploads (Multer)
UPLOAD_DIR=uploads/
MAX_FILE_SIZE_BYTES=10485760

# Jira Integration (Reserved for Member 3)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=jira-admin@college.edu
JIRA_API_TOKEN=your_jira_api_token
JIRA_SERVICE_DESK_ID=
JIRA_REQUEST_TYPE_ID=
